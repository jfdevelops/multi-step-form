{
  "name": "@jfdevelops/multi-step-form-builder-core",
  "version": "0.0.0",
  "description": "Framework-agnostic headless form builder for @jfdevelops/multi-step-form",
  "repository": "https://github.com/jfdevelops/multi-step-form",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "forms",
    "form-builder",
    "headless",
    "multi-step-form"
  ],
  "author": "Joey Finkel",
  "license": "MIT",
  "dependencies": {
    "@jfdevelops/multi-step-form-core": "workspace:*",
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.11",
    "vitest": "^4.0.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
